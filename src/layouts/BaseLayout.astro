---
import "@styles/global.css";
import type { Lang } from "@data/site";
import { alternateLinks } from "@data/site";

type Props = {
  lang: Lang;
  title: string;
  description: string;
  path: string;
};

const { lang, title, description, path } = Astro.props;
const canonical = new URL(path, Astro.site ?? "https://02signal.ai").toString();
const alternates = alternateLinks(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((item) => <link rel="alternate" hreflang={item.lang} href={new URL(item.href, Astro.site ?? "https://02signal.ai").toString()} />)}
    <link rel="alternate" hreflang="x-default" href={new URL("/et/", Astro.site ?? "https://02signal.ai").toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/images/hero-process-audit.png", Astro.site ?? "https://02signal.ai").toString()} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
