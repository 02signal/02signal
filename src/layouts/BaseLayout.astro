---
import "@styles/global.css";
import type { Lang } from "@data/site";
import { alternateLinks } from "@data/site";

type AnalyticsEvent = {
  name: string;
  params?: Record<string, string | number | boolean | null | undefined>;
};

type Props = {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  analyticsEvent?: AnalyticsEvent;
};

const { lang, title, description, path, schema, analyticsEvent } = Astro.props;
const site = Astro.site ?? "https://02signal.ai";
const siteUrl = new URL("/", site).toString();
const canonical = new URL(path, site).toString();
const alternates = alternateLinks(lang);
const pageSchema = Array.isArray(schema) ? schema : schema ? [schema] : [];
const phone = "+37258180435";
const gaMeasurementId = (
  import.meta.env.PUBLIC_GA_MEASUREMENT_ID ??
  process.env.PUBLIC_GA_MEASUREMENT_ID ??
  ""
).trim();
const analyticsEventJson = JSON.stringify(analyticsEvent ?? null).replace(/</g, "\\u003c");
const analyticsCopy = {
  et: {
    text: "Kasutame Google Analyticsit, et näha, millised lehed aitavad külastajal järgmise sammuni jõuda.",
    accept: "Luba mõõtmine",
    decline: "Ei luba"
  },
  en: {
    text: "We use Google Analytics to see which pages help visitors reach the next step.",
    accept: "Allow analytics",
    decline: "Decline"
  },
  ru: {
    text: "Мы используем Google Analytics, чтобы понимать, какие страницы помогают посетителю сделать следующий шаг.",
    accept: "Разрешить",
    decline: "Не разрешать"
  }
}[lang];
const analyticsInitScript = gaMeasurementId
  ? `
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
window.gtag = gtag;
gtag("consent", "default", {
  analytics_storage: "denied",
  ad_storage: "denied",
  ad_user_data: "denied",
  ad_personalization: "denied"
});
gtag("js", new Date());
window.track02SignalEvent = (eventName, params = {}) => {
  if (!eventName || localStorage.getItem("analyticsConsent") !== "granted") return;
  gtag("event", eventName, {
    event_category: "02signal_funnel",
    page_path: window.location.pathname,
    transport_type: "beacon",
    ...params
  });
};
window.track02SignalPageEvent = () => {
  const pageEvent = ${analyticsEventJson};
  if (!pageEvent?.name) return;
  window.track02SignalEvent(pageEvent.name, pageEvent.params || {});
};
if (localStorage.getItem("analyticsConsent") === "granted") {
  gtag("consent", "update", { analytics_storage: "granted" });
  gtag("config", ${JSON.stringify(gaMeasurementId)}, { anonymize_ip: true });
  window.track02SignalPageEvent();
}
`
  : "";
const analyticsConsentScript = gaMeasurementId
  ? `
(() => {
  const banner = document.querySelector("[data-analytics-consent]");
  if (!banner || !window.gtag) return;

  const storedConsent = localStorage.getItem("analyticsConsent");
  if (!storedConsent) banner.hidden = false;

  banner.querySelector("[data-analytics-accept]")?.addEventListener("click", () => {
    localStorage.setItem("analyticsConsent", "granted");
    window.gtag("consent", "update", { analytics_storage: "granted" });
    window.gtag("config", ${JSON.stringify(gaMeasurementId)}, { anonymize_ip: true });
    window.track02SignalPageEvent?.();
    banner.hidden = true;
  });

  banner.querySelector("[data-analytics-decline]")?.addEventListener("click", () => {
    localStorage.setItem("analyticsConsent", "denied");
    window.gtag("consent", "update", { analytics_storage: "denied" });
    banner.hidden = true;
  });

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const action = target.closest("a, button");
    if (!(action instanceof HTMLElement)) return;

    const explicitEvent = action.dataset.analyticsEvent;
    if (explicitEvent) {
      window.track02SignalEvent?.(explicitEvent, {
        link_text: action.textContent?.trim().slice(0, 80) || "",
        event_source: action.dataset.analyticsSource || "explicit"
      });
      return;
    }

    if (!(action instanceof HTMLAnchorElement)) return;
    const href = action.href;
    const linkText = action.textContent?.trim().slice(0, 80) || "";
    if (href.startsWith("tel:")) {
      window.track02SignalEvent?.("phone_click", {
        link_text: linkText,
        link_url: "tel:+37258180435"
      });
    } else if (href.startsWith("mailto:")) {
      window.track02SignalEvent?.("lead_email_click", {
        link_text: linkText,
        link_url: href.split("?")[0]
      });
    }
  });
})();
`
  : "";
const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}#organization`,
      name: "02Signal",
      legalName: "Ettevõtluskeskus OÜ",
      url: siteUrl,
      email: "info@02signal.ai",
      telephone: phone,
      description:
        "02Signal aitab Eesti mikro- ja väikeettevõtetel valida ja ehitada esimese praktilise AI abilise.",
      areaServed: "EE",
      contactPoint: [
        {
          "@type": "ContactPoint",
          telephone: phone,
          email: "info@02signal.ai",
          contactType: "customer service",
          areaServed: "EE",
          availableLanguage: ["et", "en", "ru"]
        }
      ],
      knowsAbout: [
        "AI automatiseerimine",
        "AI abiline",
        "n8n automatiseerimine",
        "agentic workflow",
        "äriprotsesside automatiseerimine"
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      name: "02Signal",
      url: siteUrl,
      publisher: {
        "@id": `${siteUrl}#organization`
      },
      inLanguage: ["et", "en", "ru"]
    },
    ...pageSchema
  ]
};
const schemaJson = JSON.stringify(schemaGraph).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((item) => <link rel="alternate" hreflang={item.lang} href={new URL(item.href, site).toString()} />)}
    <link rel="alternate" hreflang="x-default" href={new URL("/et/", site).toString()} />
    <meta name="robots" content="index,follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/images/hero-process-audit.png", site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    {gaMeasurementId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaMeasurementId)}`}></script>}
    {gaMeasurementId && <script is:inline set:html={analyticsInitScript}></script>}
    <script is:inline type="application/ld+json" set:html={schemaJson}></script>
  </head>
  <body>
    <slot />
    {
      gaMeasurementId && (
        <div class="consent-banner" data-analytics-consent hidden>
          <p>{analyticsCopy.text}</p>
          <div>
            <button class="btn btn-primary" type="button" data-analytics-accept>{analyticsCopy.accept}</button>
            <button class="btn btn-light" type="button" data-analytics-decline>{analyticsCopy.decline}</button>
          </div>
        </div>
      )
    }
    {gaMeasurementId && <script is:inline set:html={analyticsConsentScript}></script>}
  </body>
</html>
