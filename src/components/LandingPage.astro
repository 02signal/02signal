---
import AuditSteps from "@components/AuditSteps.astro";
import FilterBox from "@components/FilterBox.astro";
import Footer from "@components/Footer.astro";
import FormatCards from "@components/FormatCards.astro";
import Header from "@components/Header.astro";
import Hero from "@components/Hero.astro";
import LeadForm from "@components/LeadForm.astro";
import ProcessMap from "@components/ProcessMap.astro";
import ScopeCards from "@components/ScopeCards.astro";
import SectionHead from "@components/SectionHead.astro";
import ValueCards from "@components/ValueCards.astro";
import FitList from "@components/FitList.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { copy, type Lang } from "@data/site";

type Props = {
  lang: Lang;
  path?: string;
};

const { lang, path } = Astro.props;
const page = copy[lang];
const canonicalPath = path ?? page.meta.path;
const site = Astro.site ?? "https://02signal.ai";
const pageUrl = new URL(canonicalPath, site).toString();
const schema = [
  {
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: page.hero.title,
    serviceType:
      lang === "et"
        ? "AI automatiseerimine, AI kiirkontroll ja AI abivahendi ehitus"
        : lang === "en"
          ? "AI automation process audit and implementation"
          : "Аудит процессов и внедрение AI-автоматизации",
    description: page.meta.description,
    provider: {
      "@id": new URL("/#organization", site).toString()
    },
    areaServed: lang === "et" ? "EE" : "Europe",
    audience: {
      "@type": "Audience",
      audienceType:
        lang === "et"
          ? "Eesti mikro- ja väikeettevõtte omanikud ja juhid"
          : lang === "en"
            ? "SME owners and leaders"
            : "Руководители малого и среднего бизнеса"
    },
    offers:
      lang === "et"
        ? {
            "@type": "AggregateOffer",
            priceCurrency: "EUR",
            lowPrice: 0,
            highPrice: 9900,
            offerCount: 4,
            availability: "https://schema.org/InStock"
          }
        : undefined
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "02Signal",
        item: new URL(`/${lang}/`, site).toString()
      }
    ]
  }
];
const decisionCards =
  lang === "et"
    ? [
        {
          label: "Ma ei tea, kas AI sobib",
          title: "Alusta tasuta kiirkontrollist",
          text: "10 minutit. Saate kohe pildi, kas tasub jätkata ja mis vajab enne korrastamist.",
          cta: "Tee kiirkontroll",
          href: "/et/kiirkontroll/"
        },
        {
          label: "Mul on mitu võimalikku kohta",
          title: "Võta 90-min AI alguse nõu",
          text: "Vaatame 2-3 ajaröövlit läbi ja ütleme, millest alustada või mida praegu mitte puutuda.",
          cta: "Räägime üle",
          href: "#contact"
        },
        {
          label: "Üks korduv töö on juba selge",
          title: "Vaata AI abivahendi ehitust",
          text: "Kui inimene saab tulemust kontrollida, saab väikese lahenduse ehitada kindla mahuga.",
          cta: "Vaata ehitust",
          href: "/et/elluviimine/"
        }
      ]
    : null;
---

<BaseLayout lang={lang} title={page.meta.title} description={page.meta.description} path={canonicalPath} schema={schema}>
  <Header lang={lang} nav={page.nav} />
  <main id="top">
    <Hero hero={page.hero} />

    {
      decisionCards && (
        <section class="choice-band" aria-labelledby="choice-title">
          <div class="section-inner">
            <div class="choice-head">
              <span class="section-kicker">Kiire valik</span>
              <h2 id="choice-title">Milline olukord on teile kõige lähemal?</h2>
            </div>
            <div class="choice-grid">
              {decisionCards.map((card) => (
                <a class="choice-item" href={card.href}>
                  <span>{card.label}</span>
                  <strong>{card.title}</strong>
                  <p>{card.text}</p>
                  <em>{card.cta}</em>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section id="what" class="white-band">
      <div class="section-inner">
        <SectionHead kicker={page.what.kicker} title={page.what.title} lead={page.what.lead} />
        <ValueCards cards={page.what.cards} />
      </div>
    </section>

    <section id="formats" class="mint-band">
      <div class="section-inner">
        <SectionHead kicker={page.formats.kicker} title={page.formats.title} lead={page.formats.lead} />
        <FormatCards cards={page.formats.cards} />
      </div>
    </section>

    <section class="white-band">
      <div class="section-inner">
        <SectionHead kicker={page.fit.kicker} title={page.fit.title} />
        <FitList items={page.fit.items} />
      </div>
    </section>

    <section class="navy-band">
      <div class="section-inner">
        <FilterBox filter={page.filter} />
      </div>
    </section>

    <section id="audit" class="white-band">
      <div class="section-inner">
        <SectionHead kicker={page.audit.kicker} title={page.audit.title} lead={page.audit.lead} />
        <AuditSteps steps={page.audit.steps} />
      </div>
    </section>

    <section id="example" class="mint-band">
      <div class="section-inner">
        <SectionHead kicker={page.example.kicker} title={page.example.title} lead={page.example.lead} />
        <ProcessMap example={page.example} />
      </div>
    </section>

    <section class="white-band">
      <div class="section-inner">
        <SectionHead kicker={page.scope.kicker} title={page.scope.title} />
        <ScopeCards scope={page.scope} />
      </div>
    </section>

    <section id="contact" class="navy-band">
      <div class="section-inner contact-grid">
        <div class="section-head">
          <span class="section-kicker">{page.contact.kicker}</span>
          <h2>{page.contact.title}</h2>
          <p>{page.contact.lead}</p>
          <div class="inline-actions">
            <a class="btn btn-primary" href={`mailto:info@02signal.ai?subject=${encodeURIComponent(page.form.mailSubject)}`}>
              {page.contact.emailCta}
            </a>
          </div>
        </div>
        <div class="contact-panel">
          <LeadForm form={page.form} />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
